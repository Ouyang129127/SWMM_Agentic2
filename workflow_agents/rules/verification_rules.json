{
  "schema_name": "swmm_ca2d_verification_rules",
  "schema_version": "0.1",
  "required_metrics_by_claim_type": {
    "surface_ponding_risk": ["max_depth", "ponding_duration"],
    "surface_hotspot": ["max_depth"],
    "long_duration_ponding": ["ponding_duration"],
    "major_overflow_node": ["total_flooding_volume", "max_flooding_flow", "overflow_event_count"],
    "high_load_link": ["max_fullness", "fullness_ge_0_8_duration", "fullness_ge_0_95_duration", "surcharge_duration", "max_flow"],
    "unstable_flow_direction_link": ["flow_direction_changes"],
    "node_overflow_with_surface_ponding": ["total_flooding_volume", "flooding_duration", "max_depth", "ponding_duration"],
    "node_overflow_with_downstream_high_fullness": ["total_flooding_volume", "max_fullness", "fullness_ge_0_8_duration", "fullness_ge_0_95_duration", "surcharge_duration", "max_flow"],
    "node_overflow_with_upstream_high_load": ["total_flooding_volume", "max_fullness", "fullness_ge_0_8_duration", "fullness_ge_0_95_duration", "surcharge_duration", "max_flow"],
    "node_overflow_with_flow_direction_instability": ["total_flooding_volume", "flow_direction_changes"],
    "node_repeated_overflow": ["overflow_event_count"]
  },
  "require_all_metrics_by_claim_type": {
    "surface_ponding_risk": true
  },
  "allow_same_object_type_match": true,
  "supported_statuses": ["supported", "partially_supported", "unsupported", "uncertain"]
}
