{
  "schema_name": "swmm_ca2d_evidence_graph_schema",
  "schema_version": "0.1",
  "description": "Ontology-inspired schema for the first-stage SWMM-CA2D flood diagnostic evidence graph.",
  "scope": {
    "status": "minimum_viable_schema",
    "anchor_strategy": "overflow_node_centered",
    "implemented_first": [
      "rainfall_context",
      "object_type_definitions",
      "relation_type_definitions",
      "diagnostic_package_contract"
    ],
    "next_outputs": [
      "evidence_relation_table.csv",
      "overflow_node_evidence_packages.json"
    ]
  },
  "object_types": {
    "cell": {
      "canonical_name": "SurfaceCell",
      "description": "2D surface cell used to represent ponding depth and duration.",
      "core_fields": ["object_id", "x", "y", "ground_elevation", "runoff_coefficient"],
      "evidence_metrics": ["max_depth", "ponding_duration"]
    },
    "node": {
      "canonical_name": "JunctionNode",
      "description": "SWMM drainage junction or manhole node.",
      "core_fields": ["object_id", "x", "y", "ground_elevation", "invert_elevation"],
      "evidence_metrics": ["total_flooding_volume", "max_flooding_flow", "flooding_duration", "overflow_event_count", "max_node_depth"]
    },
    "link": {
      "canonical_name": "ConduitLink",
      "description": "SWMM conduit link used to represent pipe hydraulic state.",
      "core_fields": ["object_id", "from_node", "to_node", "length", "full_depth"],
      "evidence_metrics": ["max_fullness", "max_flow", "max_link_depth", "flow_direction_changes"]
    },
    "rainfall_event": {
      "canonical_name": "RainfallEvent",
      "description": "Rainfall event context used as upstream diagnostic background.",
      "core_fields": [
        "event_name",
        "total_rainfall_mm",
        "rainfall_duration_min",
        "max_intensity_mm_per_h",
        "rainfall_peak_time",
        "intensity_class"
      ],
      "evidence_metrics": [
        "total_rainfall",
        "max_intensity",
        "rainfall_duration",
        "rainfall_peak_time",
        "intensity_class"
      ]
    }
  },
  "relation_types": {
    "node_near_cell": {
      "source_type": "node",
      "target_type": "cell",
      "direction": "nearby",
      "data_source": "geometry",
      "confidence": "medium",
      "description": "Surface cell located near an overflow node."
    },
    "cell_adjacent_to_cell": {
      "source_type": "cell",
      "target_type": "cell",
      "direction": "adjacent",
      "data_source": "cell_grid",
      "confidence": "high",
      "description": "4-neighbor or 8-neighbor adjacency between surface cells."
    },
    "node_connected_to_link": {
      "source_type": "node",
      "target_type": "link",
      "direction": "upstream_or_downstream",
      "data_source": "swmm_topology",
      "confidence": "high",
      "description": "Direct SWMM topology connection between a node and conduit."
    },
    "link_upstream_of_link": {
      "source_type": "link",
      "target_type": "link",
      "direction": "upstream",
      "data_source": "swmm_topology",
      "confidence": "high",
      "description": "Upstream trace relation between conduit links."
    },
    "link_downstream_of_link": {
      "source_type": "link",
      "target_type": "link",
      "direction": "downstream",
      "data_source": "swmm_topology",
      "confidence": "high",
      "description": "Downstream trace relation between conduit links."
    }
  },
  "rainfall_context": {
    "output_file": "evidence/rainfall_context.json",
    "fields": {
      "total_rainfall_mm": "Stepwise accumulated rainfall depth from intensity time series.",
      "rainfall_duration_min": "Duration between first and last rainfall timestamps.",
      "effective_rainfall_duration_min": "Positive rainfall duration proxy.",
      "max_intensity_mm_per_h": "Peak rainfall intensity.",
      "mean_intensity_mm_per_h": "Total rainfall divided by rainfall duration.",
      "rainfall_peak_time": "Timestamp of peak rainfall intensity.",
      "intensity_class": "light_rain, moderate_rain, heavy_rain, rainstorm, heavy_rainstorm, short_duration_heavy_rainfall, or unknown.",
      "short_duration_heavy_rainfall": "Boolean flag for short-duration high-intensity rainfall.",
      "classification_basis": "The standard or threshold set used by the classification."
    },
    "current_classification_basis": "internal_thresholds_pending_local_standard_calibration"
  },
  "evidence_relation_table": {
    "output_file": "evidence/evidence_relation_table.csv",
    "columns": [
      "relation_id",
      "run_id",
      "source_type",
      "source_id",
      "target_type",
      "target_id",
      "relation_type",
      "direction",
      "distance_m",
      "topology_order",
      "weight",
      "confidence",
      "data_source",
      "evidence_ids"
    ]
  },
  "overflow_node_evidence_package": {
    "output_file": "evidence/overflow_node_evidence_packages.json",
    "required_sections": [
      "package_id",
      "diagnostic_summary",
      "anchor",
      "rainfall_context",
      "node_evidence",
      "surface_context",
      "network_context",
      "relation_paths",
      "diagnosis_ready_signals"
    ],
    "diagnosis_ready_signals": [
      "has_surface_ponding_nearby",
      "has_downstream_high_fullness",
      "has_upstream_high_load",
      "has_flow_direction_instability",
      "has_repeated_overflow",
      "has_short_duration_heavy_rainfall"
    ],
    "diagnostic_summary_fields": [
      "anchor_node",
      "diagnostic_unit",
      "rainfall_class",
      "node_total_flooding_volume_m3",
      "node_flooding_duration_min",
      "node_overflow_event_count",
      "surface_cluster_cell_count",
      "surface_cluster_max_depth_m",
      "surface_cluster_max_duration_min",
      "connected_link_count",
      "upstream_trace_max_fullness",
      "downstream_trace_max_fullness",
      "diagnostic_signals",
      "diagnostic_readiness"
    ],
    "context_summaries": {
      "surface_context.ponding_cluster.summary": [
        "cell_count",
        "total_area_m2",
        "max_depth_m",
        "mean_depth_m",
        "max_duration_min",
        "mean_duration_min",
        "min_ground_elevation_m",
        "mean_ground_elevation_m",
        "max_ground_elevation_m",
        "top_cells_by_depth"
      ],
      "network_context.summary": [
        "connected_link_count",
        "upstream_direct_link_count",
        "downstream_direct_link_count",
        "upstream_trace_count",
        "downstream_trace_count",
        "upstream_stop_reasons",
        "downstream_stop_reasons",
        "connected_link_stats",
        "upstream_trace_stats",
        "downstream_trace_stats"
      ],
      "relation_paths.summary": [
        "anchor",
        "relation_count",
        "evidence_count",
        "diagnostic_role"
      ]
    }
  }
}
